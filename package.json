{
  "name": "browser-close-multiple-tabs",
  "version": "2.1.0",
  "private": true,
  "description": "Close browser tabs above, below, or all other tabs with shortcut keys or the context menu.",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:chrome": "wxt -b chrome --mv3",
    "dev:edge": "wxt -b edge --mv3",
    "build": "wxt build -b chrome --mv3",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "build:all": "pnpm run clean && pnpm run build:chrome && pnpm run build:edge",
    "zip": "wxt zip -b chrome --mv3",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:edge": "wxt zip -b edge --mv3",
    "zip:all": "pnpm run clean && pnpm run zip:chrome && pnpm run zip:edge",
    "clean": "rimraf .output",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@wxt-dev/auto-icons": "^1.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.20.26"
  },
  "packageManager": "pnpm@11.25.0"
}
